# Reddit: create a free "script" app at https://reddit.com/prefs/apps (redirect uri doesn't matter for script apps)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=memecoin-scanner/0.1 by <your_reddit_username>

# LunarCrush: works once you're on Individual tier or higher (lunarcrush.com/pricing)
LUNARCRUSH_API_KEY=

# CoinMarketCap: console.coinmarketcap.com
COINMARKETCAP_API_KEY=

# CoinMarketCal (events calendar, NOT CoinMarketCap — different service):
# coinmarketcal.com/developer/signup. Free tier: top-100 coins only, 24h
# delayed — most meme symbols here won't have coverage, best-effort only.
COINMARKETCAL_API_KEY=

# Telegram (telethon, logs in as YOUR account, not a bot) — get api_id/api_hash
# at my.telegram.org -> API Development Tools. TELEGRAM_SIGNAL_CHAT is the
# @handle or display name of the premium-signals bot/chat to read from.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SIGNAL_CHAT=
# Only needed once, for telegram_login.py's login step — not read afterward.
TELEGRAM_PHONE=

# LLM reasoning layer runs on local Ollama (free, no key) — see scanner.py

# Binance TESTNET — get a SEPARATE key at testnet.binance.vision, do NOT
# reuse trading-system's testnet account (that one's mid-soak; mixing orders
# into it corrupts its portfolio reconciliation).
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_BASE_URL=https://testnet.binance.vision

# Max fraction of liquid portfolio value that can be deployed in open
# meme-coin positions at once (0.3 = 30%) — a TOTAL ceiling across all
# positions, not one trade's size. Scales with account size instead of an
# arbitrary N.
MAX_PORTFOLIO_PCT=0.3

# Each individual trade is capped at (MAX_PORTFOLIO_PCT / POSITION_SPLIT) of
# the portfolio, so the cap gets used up across multiple concurrent
# positions instead of one oversized bet locking out every other signal.
POSITION_SPLIT=5

# Kelly-criterion-style circuit breaker: once the portfolio drawdown from its
# recorded peak (portfolio_peak.json) reaches this fraction, POSITION_SPLIT
# doubles (bet size halves) until the portfolio recovers. Shrinks bets during
# a losing streak instead of trying to trade back to even.
DRAWDOWN_CIRCUIT_BREAKER_PCT=0.20

# Two-cycle momentum confirmation (last_top_candidate.json) requires the same
# symbol to rank #1 on two consecutive 5min cycles before betting - skips
# one-candle spikes that reverse immediately. Not configurable, always on.

# RSI(14, 1h) overbought skip - don't buy into an already-exhausted move.
RSI_OVERBOUGHT_THRESHOLD=75

# A trade only fires if the room left under the portfolio cap is at least
# this fraction of the normal per-trade size (MAX_PORTFOLIO_PCT/POSITION_SPLIT).
# Otherwise skip and wait for room to free up - stops a good signal getting a
# scrap-sized bet just because the cap is nearly full (DEXE got $83 of a
# normal ~$4,300 bet this way; an 18.8% return became $16.87 instead of ~$800).
MIN_BET_FRACTION=0.5

# Golden trade: a verdict with confidence >= GOLDEN_CONFIDENCE_THRESHOLD can
# draw from a SEPARATE reserve (GOLDEN_RESERVE_PCT of portfolio) that sits
# outside the normal MAX_PORTFOLIO_PCT cap entirely - checked even when
# normal room is exhausted. Not split like normal trades (no POSITION_SPLIT
# division) - one full-conviction shot per golden opportunity, tracked
# separately (golden_trade_ids.json) so the two pools never interfere.
GOLDEN_CONFIDENCE_THRESHOLD=0.85
GOLDEN_RESERVE_PCT=0.20
# One golden trade uses at most 1/GOLDEN_SPLIT of the reserve (5% of
# portfolio by default), not the whole 20% in one shot.
GOLDEN_SPLIT=4

# Opportunity score: two independent confidence scores (Kronos ML forecast,
# LLM verdict) blended into the actual buy/no-buy gate, instead of the LLM's
# own confidence being the only thing that decides. Fixes an observed
# pattern: NIL/PROM/PUMP/COTI all lost after Kronos explicitly forecast a
# decline and the LLM bought anyway because raw momentum pushed its own
# confidence over the old flat 0.5 bar.
# KRONOS_NORMALIZE_PCT: a +/-N% Kronos forecast maps to +/-1.0 conviction.
KRONOS_NORMALIZE_PCT=5
# KRONOS_VETO_THRESHOLD: Kronos alone hard-blocks a trade below this percent
# forecast, no matter how confident the LLM is (same -5% bar used for
# early-exit "fading" calls elsewhere).
KRONOS_VETO_THRESHOLD=-5
# Blend weights (kronos_score is -1..+1, llm_score is 0..1) and the pass bar.
KRONOS_WEIGHT=0.3
LLM_WEIGHT=0.7
OPPORTUNITY_THRESHOLD=0.3

# Market breadth regime filter: computed from the same full-universe momentum
# scan already fetched for ranking (no extra API calls). Below
# BREADTH_WEAK_UP_PCT of the universe up over the 1h window -> weak breadth,
# POSITION_SPLIT doubles (bet size halves), same mechanism as the drawdown
# circuit breaker but triggered by market conditions instead of our own P&L.
# Reactive/lagging like any breadth measure - can sit out the first leg of a
# recovery since it only reacts after the split has already gone negative.
BREADTH_WEAK_UP_PCT=0.35
BREADTH_SPLIT_MULTIPLIER=2

# Universe eligibility: any token (majors included, not just alt/meme coins)
# trading under this price qualifies for the scan/rank/trade pipeline.
MAX_PRICE_USD=5.0

# Binance FUTURES testnet (testnet.binancefuture.com) - separate account
# from the Spot testnet above. Used for short execution only (execute_futures.py).
BINANCE_FUTURES_API_KEY=
BINANCE_FUTURES_API_SECRET=
BINANCE_FUTURES_BASE_URL=https://testnet.binancefuture.com

FUTURES_LEVERAGE=3
FUTURES_MAX_PORTFOLIO_PCT=0.3
FUTURES_POSITION_SPLIT=5
FUTURES_STOP_LOSS_PCT=0.15
FUTURES_TAKE_PROFIT_PCT=0.30
# Don't short a token whose RSI is already this oversold - bounce risk.
FUTURES_RSI_OVERSOLD_THRESHOLD=25

# ATR-based (volatility-adjusted) stop-loss, replacing one flat % for every
# symbol on BOTH the spot-long and futures-short paths - Turtle-style:
# stop = ATR_MULTIPLIER x ATR(14, 1h), expressed as % of price, clamped to
# [ATR_MIN_STOP_LOSS_PCT, ATR_MAX_STOP_LOSS_PCT]. Falls back to the flat 15%
# default (DEFAULT_STOP_LOSS_PCT / FUTURES_STOP_LOSS_PCT) if ATR can't be
# computed this cycle.
ATR_MULTIPLIER=2
ATR_MIN_STOP_LOSS_PCT=0.08
ATR_MAX_STOP_LOSS_PCT=0.25
